# Optional. Defaults shown. Copy to .env.local to override.
# SQLite file location (relative to command-center/)
DATABASE_PATH=data/command-center.db

# ---- CC-01 auth ----
# Hosted (non-local) deployment: 2FA is mandatory (BR-19). Also on automatically when VERCEL=1.
CC_HOSTED=0
# Local runs only: allow password-only sign-in until 2FA is enrolled. Ignored when hosted.
CC_ALLOW_PASSWORD_ONLY=0
# Extra origins accepted by the Origin (CSRF) check, comma-separated. Empty = the request's own host.
CC_ALLOWED_ORIGINS=
# Proxies in front of the app that append to X-Forwarded-For (client IP for throttling).
CC_TRUSTED_PROXY_HOPS=1

# ---- Test-only overrides: honoured ONLY when NODE_ENV=test (vitest), ignored otherwise ----
# CC_TEST_NOW=2026-11-15T12:00:00.000Z
# CC_TEST_IDLE_MS=        (default 12 h)
# CC_TEST_ABSOLUTE_MS=    (default 7 days)
# CC_TEST_ENROL_MS=       (default 30 min)
# CC_TEST_THROTTLE_WINDOW_MS= (default 15 min)
# CC_TEST_LOCKOUT_MS=     (default 15 min)
# CC_TEST_BACKOFF_BASE_MS= / CC_TEST_BACKOFF_MAX_MS= (default 1 s / 60 s)
# CC_TEST_DAILY_CUTOFF=   (HH:MM, default 18:00 Toronto)
